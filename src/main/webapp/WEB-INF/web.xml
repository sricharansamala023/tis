<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Tourist Information System</display-name>
    <description>Multi-city Tourist Information System for India - 10 cities, 100 places (PBLJ Project No. 16)</description>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!--
        Servlet mappings are also declared via @WebServlet annotations in the
        Java classes; they are repeated here as comments for clarity during
        viva / demonstration:

        HomeServlet      -> /home and /cities  (city lists for the home page and Cities page)
        CityServlet      -> /city
        TouristServlet    -> /place
        SearchServlet     -> /search
        CategoryServlet   -> /category
        FeedbackServlet   -> /feedback
    -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
